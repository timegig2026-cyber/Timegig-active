{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "termsAccepted": { "type": "boolean" }
      },
      "required": ["uid", "email", "termsAccepted"]
    },
    "settings": {
      "title": "Settings",
      "description": "Platform settings and spot limits",
      "type": "object",
      "properties": {
        "maxTenants": { "type": "integer" },
        "maxSubscribers": { "type": "integer" }
      }
    },
    "gig": {
      "title": "Gig",
      "description": "Active gig hiring requests and live navigation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "seekerId": { "type": "string" },
        "seekerEmail": { "type": "string" },
        "customerId": { "type": "string" },
        "customerEmail": { "type": "string" },
        "destinationAddress": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined", "completed", "cancelled"] }
      },
      "required": ["id", "seekerId", "customerId", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "user" },
      "description": "User profiles"
    },
    "/settings/{settingsId}": {
      "schema": { "$ref": "settings" },
      "description": "Platform global settings"
    },
    "/gigs/{gigId}": {
      "schema": { "$ref": "gig" },
      "description": "Live gigs and hire requests"
    }
  }
}
