rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /settings/{settingsId} {
      allow read, write: if request.auth != null;
    }

    match /gigs/{gigId} {
      allow read, write: if request.auth != null;
    }
  }
}
